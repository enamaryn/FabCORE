{
  "name": "fabcore",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "start": "node poc/server.mjs",
    "dev": "node --watch poc/server.mjs",
    "test": "node --import ./scripts/test-network-isolation.mjs --test",
    "typecheck": "tsc -p . && tsc -p web",
    "lint": "eslint",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run check:licenses && node scripts/openapi.mjs --check && npm run build:web",
    "openapi": "node scripts/openapi.mjs",
    "build:web": "node scripts/build-web.mjs",
    "dev:web": "vite --config web/vite.config.ts"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.3",
    "basic-ftp": "^6.2.6",
    "fastify": "^5.12.7",
    "kysely": "^0.29.9",
    "mqtt": "^5.16.1",
    "nodemailer": "^10.6.0",
    "openid-client": "^6.9.0",
    "pg": "^8.23.1",
    "typebox": "^1.4.5",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/react-query": "^5.108.4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "i18next": "^27.2.5",
    "i18next-icu": "^2.7.1",
    "intl-messageformat": "^12.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "~7.3.8"
  },
  "workspaces": [
    "packages/connector-sdk",
    "connectors/*"
  ]
}
